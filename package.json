{
  "name": "weblist",
  "private": true,
  "version": "1.0.0",
  "author": "ntyu2 and Ksois",
  "type": "module",
  "homepage": "https://blist.ksois.com",
  "scripts": {
    "dev": "npm run build:aredl && vite",
    "build:aredl": "node scripts/fetch-aredl.mjs",
