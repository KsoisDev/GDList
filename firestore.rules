rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function account() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeAccount() {
      return signedIn() && account().banned != true;
    }

    function isAdmin() {
      return activeAccount() && account().role in ['admin', 'owner'];
    }

    function isOwner() {
      return activeAccount() && account().role == 'owner';
    }

    function verifiedAccount() {
      return activeAccount() && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'username', 'usernameLower', 'displayName', 'avatarURL', 'role',
          'banned', 'stats', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && request.resource.data.stats.totalPoints == 0
        && request.resource.data.stats.mainPoints == 0
        && request.resource.data.stats.communityPoints == 0
        && request.resource.data.stats.mainCompletions == 0
        && request.resource.data.stats.communityCompletions == 0
        && request.resource.data.username.matches('^[a-zA-Z0-9_-]{3,20}$')
        && request.resource.data.usernameLower.matches('^[a-z0-9_-]{3,20}$')
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == userId;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'banned', 'isDeveloper', 'stats', 'displayName', 'avatarURL', 'bio', 'country', 'updatedAt']);

      allow delete: if signedIn();
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == username
        && request.resource.data.username.matches('^[a-zA-Z0-9_-]{3,20}$')
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /staff/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /levels/{levelId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /completions/{completionId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if true;
      allow update: if signedIn();
      allow delete: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if true;
      allow update, delete: if signedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /changelog/{entryId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
